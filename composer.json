{
  "name": "tenant/quan-ly-hanh-chinh",
  "description": "He thong Quan Ly Hanh Chinh multi-tenant theo cau hinh chay tren PHP 8.2 va MySQL.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-simplexml": "*",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "check:php": "php -l index.php",
    "test:policies": "php tests/policies/run.php",
    "test:policy-regression": "php tests/policies/run.php"
  }
}
