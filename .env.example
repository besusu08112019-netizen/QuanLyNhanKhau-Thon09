APP_NAME="He thong Quan ly Hanh chinh"
APP_URL=https://your-domain.example
APP_KEY=change-this-to-a-long-random-production-secret
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_DEBUG=false
APP_VERSION=v2.0
SESSION_TTL_SECONDS=21600
UPLOAD_PATH=/home/USER/public_html/uploads
STORAGE_PATH=/home/USER/app_storage
CACHE_PATH=/home/USER/app_storage/cache
LOGS_PATH=/home/USER/app_storage/logs

APP_HOST=your-domain.example
TENANT_DEFAULT_VILLAGE_ID=
TENANT_DEFAULT_VILLAGE_CODE=default
TENANT_UNIT_NAME="Ten don vi"
TENANT_HAMLET_NAME="Ten thon"
TENANT_COMMUNE_NAME="Ten xa"
TENANT_ADDRESS=""
TENANT_PHONE=""
TENANT_EMAIL=""
TENANT_WEBSITE=https://your-domain.example
TENANT_LOGO_URL=""
TENANT_BACKGROUND_URL=""
TENANT_BACKGROUND_IMAGES=""
TENANT_THEME_COLOR="#0b6b3a"
TENANT_BACKGROUND_COLOR="#eef3f8"

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tenant_database_name
DB_USERNAME=tenant_database_user
DB_PASSWORD=change-this-password
DB_CHARSET=utf8mb4

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=25M
